#!/usr/bin/env bash
#
# Release the pionia-app template under a version tag and publish to GitHub.
#
# Branch-only tooling: this script and .release/ are removed from the tagged
# commit, then restored on the branch for the next release.
#
# Usage:
#   ./release 3.0.0
#   ./release 3.0.0 --push              # push + GitHub Release
#   ./release --publish v3.0.0-beta     # push an existing tag + GitHub Release
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

VERSION=""
PUSH=false
PUBLISH_EXISTING=false

for arg in "$@"; do
    case "$arg" in
        --push) PUSH=true ;;
        --publish)
            PUBLISH_EXISTING=true
            ;;
    esac
done

if $PUBLISH_EXISTING; then
    for arg in "$@"; do
        if [[ "$arg" != --publish && "$arg" != --push ]]; then
            VERSION="$arg"
        fi
    done
else
    for arg in "$@"; do
        if [[ "$arg" != --push && "$arg" != --publish ]]; then
            VERSION="$arg"
        fi
    done
fi

usage() {
    cat <<'EOF'
Usage:
  ./release <version> [--push]
  ./release --publish <tag>

  <version>   Tag version, e.g. 3.0.0 or v3.0.0-beta
  --push      Cut (or publish if tag exists) + push branch/tags + GitHub Release
  --publish   Push an existing local tag and create a GitHub Release (no re-cut)

Examples:
  ./release 3.0.0
  ./release 3.0.0 --push
  ./release --publish v3.0.0-beta

Requires: git, GitHub CLI (gh) authenticated for --push / --publish
EOF
    exit 1
}

[[ -n "$VERSION" ]] || usage

TAG="$VERSION"
[[ "$TAG" == v* ]] || TAG="v$VERSION"

tag_exists() {
    git show-ref --verify --quiet "refs/tags/$TAG"
}

tag_commit() {
    git rev-parse "refs/tags/${TAG}^{commit}"
}

push_branch() {
    local branch="$1"
    echo "→ Pushing branch ${branch} to origin..."
    git push -u origin "refs/heads/${branch}:refs/heads/${branch}"
}

push_tag() {
    echo "→ Pushing tag ${TAG} to origin..."
    git push origin "refs/tags/${TAG}"
}

branch_tag_name_collision() {
    git show-ref --verify --quiet "refs/heads/$TAG" && tag_exists
}

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "error: not a git repository" >&2
    exit 1
fi

github_repo() {
    if command -v gh >/dev/null 2>&1; then
        gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null && return
    fi

    local url
    url="$(git remote get-url origin 2>/dev/null || true)"
    url="${url%.git}"
  url="${url#git@github.com:}"
    url="${url#https://github.com/}"
    echo "$url"
}

release_notes() {
    local tag="$1"
    cat <<EOF
## Pionia application template ${tag}

Official **Pionia v3** Moonlight REST API template for PHP 8.5+.

\`\`\`bash
composer create-project pionia/pionia-app my-api -- ${tag}
cd my-api
php pionia serve
\`\`\`

Default URL: \`http://127.0.0.1:8000/\`

### Highlights

- Moonlight API (\`/api/v1/\`) with \`WelcomeService\` starter
- RoadRunner workers (optional, \`php pionia runserver\`)
- Documented \`environment/settings.ini\` with all supported options
- Production optimization via \`php pionia optimize\` (opt-in)
EOF
}

gh_prerelease_args() {
    if [[ "$TAG" =~ -(beta|alpha|rc) ]]; then
        echo --prerelease
    fi
}

publish_to_github() {
    local tag_sha
    tag_sha="$(tag_commit)"

    if ! command -v gh >/dev/null 2>&1; then
        echo "error: GitHub CLI (gh) is required for publishing" >&2
        echo "  Install: https://cli.github.com/  then: gh auth login" >&2
        exit 1
    fi

    if ! gh auth status >/dev/null 2>&1; then
        echo "error: not logged in to GitHub — run: gh auth login" >&2
        exit 1
    fi

    local repo
    repo="$(github_repo)"
    if [[ -z "$repo" ]]; then
        echo "error: could not resolve GitHub repository from origin remote" >&2
        exit 1
    fi

    push_tag

    if gh release view "$TAG" --repo "$repo" >/dev/null 2>&1; then
        echo "→ GitHub Release ${TAG} already exists on ${repo}"
        return
    fi

    echo "→ Creating GitHub Release ${TAG} on ${repo}..."
    # shellcheck disable=SC2046
    gh release create "$TAG" \
        --repo "$repo" \
        --title "Pionia App ${TAG}" \
        --notes "$(release_notes "$TAG")" \
        --target "$tag_sha" \
        $(gh_prerelease_args)

    echo "→ https://github.com/${repo}/releases/tag/${TAG}"
}

if $PUBLISH_EXISTING; then
    if ! tag_exists; then
        if git show-ref --verify --quiet "refs/heads/$TAG"; then
            echo "error: ${TAG} is a branch name, not a tag — run: ./release ${TAG#v} --push" >&2
        else
            echo "error: tag ${TAG} does not exist locally" >&2
        fi
        exit 1
    fi

    BRANCH="$(git rev-parse --abbrev-ref HEAD)"
    echo "→ Publishing existing tag ${TAG} from branch ${BRANCH}..."
    push_branch "$BRANCH"
    publish_to_github
    exit 0
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$BRANCH" == "HEAD" ]]; then
    echo "error: detached HEAD — checkout a branch first" >&2
    exit 1
fi

if tag_exists; then
    if [[ "$PUSH" == true ]]; then
        echo "→ Tag ${TAG} already exists locally — publishing (branch + tag + GitHub Release)..."
        push_branch "$BRANCH"
        publish_to_github
        exit 0
    fi
    echo "error: tag ${TAG} already exists — use: ./release --publish ${TAG}" >&2
    echo "       or:     ./release ${TAG#v} --push   (same, if tag is already cut)" >&2
    exit 1
fi

if branch_tag_name_collision; then
    echo "note: branch and tag share the name ${TAG} — pushes use refs/heads/ and refs/tags/ explicitly" >&2
fi

if [[ ! -f release ]] || [[ ! -d .release/template ]]; then
    echo "error: release tooling missing (release and .release/template/)" >&2
    exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "warning: you have uncommitted changes; they will be included in the release commit" >&2
    read -r -p "Continue? [y/N] " answer
    [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]] || exit 1
fi

RELEASE_BAK="$(mktemp)"
TOOLING_BAK="$(mktemp -d)"
cp release "$RELEASE_BAK"
cp -a .release/. "$TOOLING_BAK/"

clean_runtime() {
    rm -rf storage/metrics storage/bootstrap 2>/dev/null || true
    find storage/cache storage/logs -mindepth 1 ! -name '.gitkeep' -delete 2>/dev/null || true
    mkdir -p storage/cache storage/logs
    touch storage/cache/.gitkeep storage/logs/.gitkeep

    rm -f \
        database.sqlite3 \
        environment/generated.ini \
        .rr.runtime.json \
        .pid \
        rr \
        2>/dev/null || true
}

clean_dev_scaffold() {
    rm -rf \
        middlewares \
        authentications \
        commands \
        providers \
        docs \
        frontend \
        public/assets \
        2>/dev/null || true

    rm -f \
        bootstrap/preload.php \
        environment/php.ini.production.example \
        2>/dev/null || true

    if [[ -d services ]]; then
        for file in services/*.php; do
            [[ -f "$file" ]] || continue
            [[ "$(basename "$file")" == "WelcomeService.php" ]] && continue
            rm -f "$file"
        done
    fi
}

apply_template() {
    local template=".release/template"

    cp "$template/environment/settings.ini" environment/settings.ini
    cp "$template/environment/.env" environment/.env
    cp "$template/switches/MainSwitch.php" switches/MainSwitch.php
    cp "$template/services/WelcomeService.php" services/WelcomeService.php
    cp "$template/storage/cache/.gitkeep" storage/cache/.gitkeep
    cp "$template/storage/logs/.gitkeep" storage/logs/.gitkeep

    if [[ -f "$template/.gitignore" ]]; then
        cp "$template/.gitignore" .gitignore
    fi
}

echo "→ Cleaning runtime artifacts..."
clean_runtime

echo "→ Removing dev scaffold..."
clean_dev_scaffold

echo "→ Applying template baseline from .release/template/..."
apply_template

echo "→ Removing branch-only release tooling from tag commit..."
rm -rf .release
rm -f release

git add -A

if git diff --cached --quiet; then
    echo "error: nothing to commit after clean — template may already match ${TAG}" >&2
    cp "$RELEASE_BAK" release
    chmod +x release
    mkdir -p .release
    cp -a "$TOOLING_BAK/." .release/
    rm -f "$RELEASE_BAK"
    rm -rf "$TOOLING_BAK"
    exit 1
fi

git commit -m "Release pionia-app template ${TAG}"

git tag -a "$TAG" -m "Pionia application template ${TAG#v}"

echo "→ Restoring release tooling on ${BRANCH}..."
cp "$RELEASE_BAK" release
chmod +x release
mkdir -p .release
cp -a "$TOOLING_BAK/." .release/
rm -f "$RELEASE_BAK"
rm -rf "$TOOLING_BAK"

git add release .release
git commit -m "Restore release tooling after ${TAG}"

TAG_SHA="$(tag_commit)"

echo ""
echo "Released ${TAG} locally (${TAG_SHA})"
echo "  Tag tree:  clean template (no release script, no dev scaffold)"
echo "  Branch:    ${BRANCH} retains ./release and .release/ for the next cut"
echo ""
echo "  composer create-project pionia/pionia-app my-api -- ${TAG}"

if [[ "$PUSH" == true ]]; then
    echo ""
    push_branch "$BRANCH"
    publish_to_github
else
    echo ""
    echo "  Publish:   ./release --publish ${TAG}"
    echo "  Or next:   ./release ${TAG#v} --push"
fi
